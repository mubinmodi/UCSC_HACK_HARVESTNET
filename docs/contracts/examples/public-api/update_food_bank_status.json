      "body": {
        "storage": [
          {
            "window": {
              "start": "2026-10-13T12:00:00-07:00",
              "end": "2026-10-14T21:00:00-07:00"
            },
            "cold_free_lb": 250,
            "dry_free_lb": 200
          }
        ],
        "pickup_windows": [
          {
            "start": "2026-10-13T18:00:00-07:00",
            "end": "2026-10-13T20:00:00-07:00"
          }
        ],
        "truck": {
          "window": {
            "start": "2026-10-13T13:00:00-07:00",
            "end": "2026-10-13T17:00:00-07:00"
          },
          "refrigerated": true,
          "capacity_lb": 250

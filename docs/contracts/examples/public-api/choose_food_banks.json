{
  "operation": "choose_food_banks",
  "group": "household",
  "method": "PUT",
  "path": "/requests/{request_code}/food-banks",
  "summary": "Set which food banks a household will collect from.",
  "synthetic": true,
  "example": {
    "request": {
      "path": "/requests/K7P4/food-banks",
      "body": {
        "food_bank_ids": [
          "rural",
          "city"
        ]
      }
    },
    "response": {
      "status": 200,
      "body": {
        "mode": "example",
        "synthetic": true,
        "request_code": "K7P4",
        "chosen_food_bank_ids": [
          "rural",
          "city"
        ],
        "status": "waiting",
        "message": "You are on the list. If you gave an email address, we can email you when produce is ready at a food bank you chose."
      }
    }
  }
}

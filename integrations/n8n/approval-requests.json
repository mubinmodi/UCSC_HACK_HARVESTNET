{
  "name": "HarvestNet - carry human review requests",
  "nodes": [
    {
      "id": "authenticated-event",
      "name": "Authenticated event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "harvestnet-approval-request",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "HarvestNet incoming event header"
        }
      }
    },
    {
      "id": "prepare-review-text",
      "name": "Prepare review text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "jsCode": "const b = $json.body; if (!b.to || !b.message || !b.decision_url || !Number.isInteger(b.version)) throw new Error('Issued human review request required'); return [{json: {to:b.to, message:b.message}}];"
      }
    },
    {
      "id": "send-text",
      "name": "Send text",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        520,
        0
      ],
      "parameters": {
        "resource": "sms",
        "operation": "send",
        "from": "={{ $vars.HARVESTNET_SMS_FROM }}",
        "to": "={{ $json.to }}",
        "message": "={{ $json.message }}",
        "options": {}
      },
      "credentials": {
        "twilioApi": {
          "id": "CONFIGURE_IN_N8N",
          "name": "HarvestNet SMS provider"
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        800,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Authenticated event": {
      "main": [
        [
          {
            "node": "Prepare review text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare review text": {
      "main": [
        [
          {
            "node": "Send text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send text": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none"
  },
  "pinData": {},
  "tags": []
}

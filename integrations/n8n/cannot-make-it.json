{
  "name": "HarvestNet - email the thank-you after Can't make it",
  "nodes": [
    {
      "id": "authenticated-event",
      "name": "Authenticated event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "harvestnet-cannot-make-it",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "HarvestNet incoming event header"
        }
      }
    },
    {
      "id": "validate-and-prepare",
      "name": "Validate and prepare",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.HARVESTNET_PLATFORM_URL + \"/notifications/prepare\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "HarvestNet API event bearer"
        }
      }
    },
    {
      "id": "check-recipient-allowlist",
      "name": "Check recipient allowlist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        390,
        0
      ],
      "parameters": {
        "jsCode": "const allow = String($vars.HARVESTNET_EMAIL_ALLOWLIST || '').split(',').map(a => a.trim().toLowerCase()).filter(Boolean); const recipient = (value) => { const to = typeof value === 'string' ? value.trim().toLowerCase() : ''; if (!allow.length || !allow.includes(to)) throw new Error('Recipient is not on HARVESTNET_EMAIL_ALLOWLIST'); return to; }; const m = $json; if (m.mode !== 'prepared_email' || typeof m.subject !== 'string' || typeof m.text !== 'string') throw new Error('A platform-prepared email is required'); return [{json: {to: recipient(m.to), subject: m.subject, text: m.text}}];"
      }
    },
    {
      "id": "send-email",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        520,
        0
      ],
      "parameters": {
        "operation": "send",
        "fromEmail": "={{ $vars.HARVESTNET_EMAIL_FROM }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "CONFIGURE_IN_N8N",
          "name": "HarvestNet Amazon SES SMTP"
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        800,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({sent: true}) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Authenticated event": {
      "main": [
        [
          {
            "node": "Validate and prepare",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate and prepare": {
      "main": [
        [
          {
            "node": "Check recipient allowlist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check recipient allowlist": {
      "main": [
        [
          {
            "node": "Send email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send email": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none"
  },
  "pinData": {},
  "tags": []
}

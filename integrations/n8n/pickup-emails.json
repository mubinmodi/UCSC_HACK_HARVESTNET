{
  "name": "HarvestNet - email committed pickup and verified Market Match tip",
  "nodes": [
    {
      "id": "authenticated-event",
      "name": "Authenticated event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "harvestnet-pickup",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "HarvestNet incoming event header"
        }
      }
    },
    {
      "id": "validate-and-prepare",
      "name": "Validate and prepare",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.HARVESTNET_PLATFORM_URL + \"/notifications/prepare\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "HarvestNet API event bearer"
        }
      }
    },
    {
      "id": "send-email",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        520,
        0
      ],
      "parameters": {
        "operation": "send",
        "fromEmail": "={{ $vars.HARVESTNET_EMAIL_FROM }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "CONFIGURE_IN_N8N",
          "name": "HarvestNet Amazon SES SMTP"
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        800,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({sent: true}) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Authenticated event": {
      "main": [
        [
          {
            "node": "Validate and prepare",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate and prepare": {
      "main": [
        [
          {
            "node": "Send email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send email": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none"
  },
  "pinData": {},
  "tags": []
}

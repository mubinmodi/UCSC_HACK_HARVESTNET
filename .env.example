# Local configuration only. Never commit a populated .env.
# Transport keys: one per sender, each host gets only its own. Generate them into a separate
# private file instead of typing them here:
#   python -m harvestnet_platform.transport_auth --output runtime/transport.env
# That file holds TRANSPORT_KEYS plus TRANSPORT_SIGNING_KEY_<SENDER> and TRANSPORT_VERIFY_KEYS_<HOST>
# for compose.platform.yaml. The join (python -m harvestnet_platform.join) signs as the turn
# publisher with TRANSPORT_SIGNING_KEY=$TRANSPORT_SIGNING_KEY_CORE.
API_EVENTS_TOKEN=
DEMO_SWITCH_TOKEN=
BEECEPTOR_BASE_URL=
CORE_API_URL=
# The approval bridge's decision-only core credential: the same value as the core's HARVESTNET_APPROVALS_TOKEN.
CORE_APPROVALS_TOKEN=
# Older local form: a JSON map of each organization to its own core staff token. Prefer CORE_APPROVALS_TOKEN.
CORE_API_TOKENS=
APPROVAL_LINK_TTL_SECONDS=3600
N8N_DECISION_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
APPROVAL_PUBLIC_URL=http://127.0.0.1:8030
AGNTCY_DIRECTORY_ADDRESS=
# Claude spending caps (LLM negotiators, voice extractor, paid evaluation). 0 means no live calls.
# The run cap is per process. The total cap is checked against the spend ledger at CLAUDE_SPEND_LEDGER
# (default runtime/claude-spend.json); blank = the run cap.
CLAUDE_RUN_CAP_USD=0
AGENT_TURN_TIMEOUT_SECONDS=60
CLAUDE_TOTAL_CAP_USD=0
# Production settings come from AWS Secrets Manager, not this template.
HARVESTNET_DOMAIN=

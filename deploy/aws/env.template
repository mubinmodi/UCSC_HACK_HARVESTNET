# HarvestNet AWS deploy settings. Copy, fill in, and load before running setup:
#
#   cp deploy/aws/env.template deploy/aws/.env      # deploy/aws/.env is gitignored
#   set -a; . deploy/aws/.env; set +a
#   deploy/aws/setup.sh --dry-run                   # check the plan
#   deploy/aws/setup.sh                             # create or update
#
# Never commit a filled-in copy. setup.sh copies the provider keys below into the
# Secrets Manager secret `harvestnet/platform` and never prints them. Leave a key
# blank to keep that service on its labeled offline fallback.

# --- Required -------------------------------------------------------------
ALERT_EMAIL=                 # AWS Budgets alerts go here
BUDGET_USD=45                # whole-account monthly budget (the account also runs clinical-trials-viz)

# --- AWS (defaults are fine) ----------------------------------------------
PROFILE=incubator
REGION=us-east-2
GIT_REF=main                 # branch or commit to deploy
INSTANCE_TYPE=t4g.micro      # t4g.small (~$17/month) if 1 GB memory gets tight
VOLUME_GB=10
CPU_CREDITS=standard         # "unlimited" boots faster but can bill extra CPU
HARVESTNET_DOMAIN=           # blank = <ip-with-dashes>.sslip.io with automatic HTTPS

# --- Claude (Anthropic) ---------------------------------------------------
ANTHROPIC_API_KEY=           # blank = no Claude calls; rules-based negotiators only
CLAUDE_RUN_CAP_USD=0         # spending cap per run, in memory per process; 0 = no paid calls
CLAUDE_TOTAL_CAP_USD=0       # total cap across runs and restarts, enforced against the spend ledger
                             # (/app/budget/claude-spend.json on the instance). Blank = the run cap;
                             # 0 = no paid calls. Keep within the $100 credit.
#   Spend from before the ledger existed is recorded once, on the instance, with
#   python -m harvestnet_agents.spend_ledger add <usd> --note "..."  (see deploy/aws/README.md)

# --- ElevenLabs voice line (#4, #22) --------------------------------------
ELEVENLABS_API_KEY=          # blank = voice line off; households use the web page

# --- Beeceptor organization systems (#16) ---------------------------------
BEECEPTOR_BASE_URL=          # e.g. https://<your-endpoint>.free.beeceptor.com; blank = recorded copies

# --- n8n approvals and pickup messages (#18) ------------------------------
N8N_DECISION_WEBHOOK_URL=    # optional outside AWS; AWS routes explicit decisions directly to the core
N8N_WEBHOOK_TOKEN=
N8N_APPROVAL_WEBHOOK_URL=    # n8n Cloud webhook for issued human review links
N8N_PICKUP_WEBHOOK_URL=      # n8n Cloud webhook for committed/changed pickup emails
N8N_RELEASE_WEBHOOK_URL=     # n8n Cloud webhook for the release thank-you email
APPROVER_EMAILS_JSON=       # optional JSON map of organization ID to staff email; wrap it in single quotes, e.g. '{"city":"you@example.org"}'

# --- Amazon SES email via n8n Cloud ---------------------------------------
SES_SENDER_EMAIL=            # verified SES From address; set the same n8n variable
SES_TEST_RECIPIENTS=         # comma-separated verified addresses while SES is sandboxed
# SES SMTP credentials belong in an n8n Cloud SMTP credential, not this file or EC2.

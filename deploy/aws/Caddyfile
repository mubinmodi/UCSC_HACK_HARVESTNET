# HarvestNet gateway (deploy/aws/compose.aws.yaml), the only Caddyfile. Routes the
# core API, the approval bridge and the demo cooler switch, plus the frontend apps from
# frontends.caddy, which deploy/aws/setup.sh generates for each frontend/<app> in the release.
# Caddy gets and renews the TLS certificate for HARVESTNET_DOMAIN by itself.
{$HARVESTNET_DOMAIN} {
	encode gzip
	handle_path /platform/* {
		reverse_proxy approvals:8030
	}
	handle /human/* {
		reverse_proxy approvals:8030
	}
	# The demo cooler switch only (#23): POST /systems/demo/<city|rural|eastside>/cooler with
	# the DEMO_SWITCH_TOKEN bearer. The systems service answers 401 without it. Every other
	# systems route (the readings) stays on the private network.
	@coolerswitch {
		method POST
		path_regexp ^/systems/demo/(city|rural|eastside)/cooler$
	}
	handle @coolerswitch {
		uri strip_prefix /systems
		reverse_proxy systems:8010
	}
	handle_path /api/* {
		reverse_proxy core:8000
	}
	handle /health {
		respond "HarvestNet gateway is up; check /api/health and /platform/health" 200
	}
	# frontends.caddy ends with a catch-all that serves frontend/landing at / (when the release has it),
	# so it must stay after every other route; the fallback below only answers when there is no landing app.
	import /etc/caddy/frontends.caddy
	handle {
		respond "HarvestNet. Core API at /api/, frontend apps listed at /apps.txt" 200
	}
}
